---
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntryBySlug } from 'astro:content';
import { site } from '../../data/site';

export async function getStaticPaths() {
	const projects = await getCollection('projects', ({ data }) => !data.draft);
	return projects.map((project) => ({ params: { slug: project.slug } }));
}

const { slug } = Astro.params;
const entry = await getEntryBySlug('projects', slug as string);

if (!entry) {
	throw new Error(`Project not found: ${slug}`);
}

const { Content, headings } = await entry.render();
const { title, description, technologies = [], github, date } = entry.data;
const toc = headings.filter((heading) => heading.depth === 2);
const formattedDate = date
	? new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
	: null;
---

<Layout title={`${title} — ${site.name}`} description={description}>
	<div class="progress" data-progress aria-hidden="true"></div>

	<article class="mx-auto max-w-6xl px-6 pb-28 pt-32">
		<a href="/projects" class="back group">
			<svg class="back__icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
				<path d="M19 12H5M11 6l-6 6 6 6"></path>
			</svg>
			Projects
		</a>

		<header class="mt-10 max-w-4xl">
			<h1 class="display-lg rise">{title}</h1>
			<p class="lead rise mt-6" style="--d: 120ms">{description}</p>

			{
				technologies.length > 0 && (
					<ul class="rise mt-8 flex flex-wrap gap-2" style="--d: 220ms" aria-label="Technologies">
						{technologies.map((tech) => (
							<li class="chip">{tech}</li>
						))}
					</ul>
				)
			}

			<div class="rise mt-8 flex flex-wrap items-center gap-x-6 gap-y-4" style="--d: 320ms">
				{
					github && (
						<a href={github} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
							<svg width="16" height="16" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
								<path fill-rule="evenodd" d="M10 0C4.477 0 0 4.477 0 10c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.868-.013-1.703-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.545 2.914 1.209.092-.937.349-1.546.635-1.901-2.22-.252-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0110 4.817c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C17.137 18.167 20 14.42 20 10c0-5.523-4.477-10-10-10z" clip-rule="evenodd" />
							</svg>
							View code
						</a>
					)
				}
				{formattedDate && <time class="text-sm text-muted" datetime={date}>{formattedDate}</time>}
			</div>
		</header>

		<div class="mt-20 grid gap-16 xl:grid-cols-[minmax(0,1fr)_15rem]">
			<div class="prose prose-lg prose-site xl:max-w-3xl">
				<Content />
			</div>

			{
				toc.length > 0 && (
					<aside class="hidden xl:block">
						<nav class="toc" aria-label="On this page">
							<p class="toc__title">On this page</p>
							<ul>
								{toc.map((heading) => (
									<li>
										<a href={`#${heading.slug}`} data-toc-link>
											{heading.text}
										</a>
									</li>
								))}
							</ul>
						</nav>
					</aside>
				)
			}
		</div>
	</article>
</Layout>

<style>
	.progress {
		position: fixed;
		inset: 0 0 auto 0;
		z-index: 60;
		height: 3px;
		transform-origin: 0 50%;
		transform: scaleX(var(--progress, 0));
		background: linear-gradient(90deg, var(--accent), var(--accent-2));
		pointer-events: none;
	}

	.back {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--muted);
		transition: color 0.3s;
	}

	.back:hover {
		color: var(--fg);
	}

	.back__icon {
		transition: transform 0.45s var(--ease);
	}

	.back:hover .back__icon {
		transform: translateX(-4px);
	}

	.toc {
		position: sticky;
		top: 7rem;
	}

	.toc__title {
		margin-bottom: 1rem;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--fg);
	}

	.toc ul {
		display: flex;
		flex-direction: column;
		border-left: 1px solid var(--line);
	}

	.toc a {
		position: relative;
		display: block;
		padding: 0.4rem 0 0.4rem 1rem;
		font-size: 0.9rem;
		line-height: 1.35;
		color: var(--muted);
		transition: color 0.3s;
	}

	.toc a::before {
		content: '';
		position: absolute;
		left: -1px;
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--accent);
		transform: scaleY(0);
		transition: transform 0.45s var(--ease);
	}

	.toc a:hover,
	.toc a[aria-current='true'] {
		color: var(--fg);
	}

	.toc a[aria-current='true']::before {
		transform: scaleY(1);
	}
</style>
