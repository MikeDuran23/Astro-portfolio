---
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Miguel Duran - Cyber Developer</title>
	</head>
	<body>
		<!-- Header Cyber -->
		<header class="sticky top-0 z-50 border-b border-cyan-500/10 backdrop-blur-md bg-gradient-to-b from-slate-950/60 to-transparent">
			<nav class="container mx-auto flex justify-between items-center py-4 px-4">
				<div class="flex items-center gap-8">
					<a href="/" class="text-2xl font-bold cyber-text hover:neon-glow transition-all duration-300">
						MIGUEL.DEV
					</a>
					<div class="hidden md:flex gap-6">
						<a href="/" class="text-slate-400 hover:text-cyan-200 font-medium transition-colors duration-300">
							INICIO
						</a>
						<a href="/projects" class="text-slate-400 hover:text-cyan-200 font-medium transition-colors duration-300">
							PROYECTOS
						</a>
					</div>
				</div>
				<div class="flex gap-2">
					<a href="https://github.com/MiguelDuranAltes" target="_blank" rel="noopener noreferrer" class="px-4 py-2 text-slate-400 hover:text-cyan-200 transition-colors duration-300 text-sm">
						GitHub
					</a>
				</div>
			</nav>
		</header>

		<main class="min-h-screen relative">
			<slot />
		</main>

		<!-- Footer Cyber -->
		<footer class="bg-gradient-to-t from-slate-950/50 to-transparent border-t border-cyan-500/10 text-slate-300 mt-20 py-12">
			<div class="container mx-auto px-4">
				<div class="grid md:grid-cols-3 gap-8 mb-8">
					<div>
						<h3 class="font-bold text-lg text-cyan-200 mb-2">MIGUEL DURAN</h3>
						<p class="text-slate-500 text-sm">Full-Stack Developer & CS Graduate</p>
					</div>
					<div>
						<h4 class="font-semibold text-cyan-200 mb-3">LINKS</h4>
						<ul class="space-y-2 text-sm text-slate-500">
							<li><a href="/projects" class="hover:text-cyan-200 transition-colors">PROJECTS</a></li>
							<li><a href="https://github.com/MiguelDuranAltes" target="_blank" class="hover:text-cyan-200 transition-colors">GITHUB</a></li>
						</ul>
					</div>
					<div>
						<h4 class="font-semibold text-cyan-200 mb-3">CONTACT</h4>
						<p class="text-sm text-slate-500">Always open to opportunities</p>
					</div>
				</div>
				<div class="border-t border-cyan-500/10 pt-8 text-center text-slate-600 text-sm">
					<p>&copy; 2026 MIGUEL DURAN. ALL RIGHTS RESERVED.</p>
				</div>
			</div>
		</footer>
	</body>
</html>

<style>
	:global(html, body) {
		margin: 0;
		width: 100%;
	}

	.cyber-text {
		color: #9ddff0;
		letter-spacing: 0.15em;
		font-weight: 800;
		text-shadow: 0 0 12px rgba(139, 233, 255, 0.18);
	}

	.neon-glow {
		text-shadow: 0 0 18px rgba(139, 233, 255, 0.22), 0 0 10px rgba(143, 103, 255, 0.12);
	}
</style>
