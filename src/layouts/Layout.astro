---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import Aurora from '../components/Aurora.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Miguel Duran — Full-stack Computer Engineer',
	description = 'Portfolio of Miguel Duran, computer engineer. Complete web applications, from backend to interface.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#060913" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Geist:wght@400..600&display=swap"
		/>

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />

		<!-- Applies the saved theme before first paint and keeps it across page navigations -->
		<script is:inline>
			(function () {
				var theme = 'dark';
				try {
					if (localStorage.getItem('theme') === 'light') theme = 'light';
				} catch (e) {}
				document.documentElement.dataset.theme = theme;
				document.addEventListener('astro:before-swap', function (event) {
					event.newDocument.documentElement.dataset.theme = document.documentElement.dataset.theme;
				});
			})();
		</script>

		<ViewTransitions />
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to content</a>
		<Aurora />
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />

		<script>
			import '../scripts/ui';
		</script>
	</body>
</html>
