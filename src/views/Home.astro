---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Stack from '../components/Stack.astro';
import Contact from '../components/Contact.astro';
import { getProjects } from '../lib/projects';
import { getLang, localePath, useTranslations } from '../i18n/ui';

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const projects = await getProjects(lang);
const featured = projects[0];
---

<Layout>
	<Hero />

	{
		featured && (
			<section class="mx-auto max-w-6xl px-6 py-16 md:py-24" aria-labelledby="featured-title">
				<div class="flex flex-wrap items-end justify-between gap-4">
					<h2 id="featured-title" class="display-md">{t.home.featured}</h2>
					{projects.length > 1 && (
						<a href={localePath(lang, '/projects')} class="link-arrow">
							{t.home.viewAll}
							<svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
								<path d="M5 12h14M13 6l6 6-6 6" />
							</svg>
						</a>
					)}
				</div>
				<div class="scroll-lift mt-10">
					<ProjectCard project={featured} />
				</div>
			</section>
		)
	}

	<Stack />
	<Contact />
</Layout>
