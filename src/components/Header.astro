---
import { site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---

<header class="site-header" data-header transition:persist="header">
	<nav class="bar" aria-label="Main">
		<a href="/" class="brand" aria-label={`${site.name}, home`}>
			<span class="brand__dot" aria-hidden="true"></span>
			<span>{site.name}</span>
		</a>

		<div class="nav" data-nav>
			<span class="nav__pill" data-nav-pill aria-hidden="true"></span>
			{
				site.nav.map((item) => (
					<a href={item.href} class="nav__link" data-nav-link aria-current={isActive(item.href) ? 'page' : undefined}>
						{item.label}
					</a>
				))
			}
		</div>

		<div class="actions">
			<a href={site.github} class="icon-btn" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
				<svg width="18" height="18" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
					<path fill-rule="evenodd" d="M10 0C4.477 0 0 4.477 0 10c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.868-.013-1.703-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.545 2.914 1.209.092-.937.349-1.546.635-1.901-2.22-.252-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0110 4.817c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C17.137 18.167 20 14.42 20 10c0-5.523-4.477-10-10-10z" clip-rule="evenodd"></path>
				</svg>
			</a>

			<button type="button" class="icon-btn" data-theme-toggle aria-label="Toggle light and dark theme">
				<svg class="theme-icon theme-icon--sun" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
				</svg>
				<svg class="theme-icon theme-icon--moon" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"></path>
				</svg>
			</button>

			<button type="button" class="icon-btn menu-btn" data-menu-button aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
				<svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true">
					<path class="menu-line menu-line--top" d="M4 8h16"></path>
					<path class="menu-line menu-line--bottom" d="M4 16h16"></path>
				</svg>
			</button>
		</div>
	</nav>

	<div id="mobile-menu" class="mobile-menu" data-menu>
		{
			site.nav.map((item) => (
				<a href={item.href} class="mobile-menu__link" data-menu-link aria-current={isActive(item.href) ? 'page' : undefined}>
					{item.label}
				</a>
			))
		}
	</div>
</header>

<style>
	.site-header {
		position: fixed;
		inset: 1rem 0 auto 0;
		z-index: 50;
		padding: 0 1rem;
		pointer-events: none;
	}

	.bar,
	.mobile-menu {
		pointer-events: auto;
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		max-width: 64rem;
		margin-inline: auto;
		padding: 0.5rem 0.5rem 0.5rem 1.25rem;
		border-radius: 999px;
		border: 1px solid var(--line);
		background: color-mix(in oklab, var(--surface) 55%, transparent);
		-webkit-backdrop-filter: blur(18px) saturate(1.4);
		backdrop-filter: blur(18px) saturate(1.4);
		transition:
			background-color 0.4s,
			box-shadow 0.5s var(--ease);
	}

	.site-header[data-scrolled] .bar {
		background: color-mix(in oklab, var(--surface) 82%, transparent);
		box-shadow: var(--shadow-soft);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		font-family: var(--f-display);
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--fg);
	}

	.brand__dot {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: linear-gradient(135deg, var(--accent), var(--accent-2));
		transition: transform 0.5s var(--ease);
	}

	.brand:hover .brand__dot {
		transform: scale(1.5);
	}

	.nav {
		position: relative;
		display: none;
		align-items: center;
		gap: 0.15rem;
		padding: 0.25rem;
	}

	@media (min-width: 768px) {
		.nav {
			display: flex;
		}
	}

	.nav__pill {
		position: absolute;
		top: 0.25rem;
		bottom: 0.25rem;
		left: 0;
		width: 0;
		border-radius: 999px;
		background: var(--raised);
		opacity: 0;
		transition:
			transform 0.55s var(--ease),
			width 0.55s var(--ease),
			opacity 0.3s;
	}

	.nav__pill:not([data-ready]) {
		transition: none;
	}

	.nav__link {
		position: relative;
		padding: 0.5rem 1.1rem;
		border-radius: 999px;
		font-size: 0.92rem;
		font-weight: 500;
		color: var(--muted);
		transition: color 0.3s;
	}

	.nav__link:hover,
	.nav__link[aria-current='page'] {
		color: var(--fg);
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.icon-btn {
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		color: var(--soft);
		transition:
			background-color 0.3s,
			color 0.3s,
			transform 0.45s var(--ease);
	}

	.icon-btn:hover {
		background: var(--raised);
		color: var(--fg);
	}

	.icon-btn:active {
		transform: scale(0.92);
	}

	.theme-icon--moon {
		display: none;
	}

	:global([data-theme='light']) .theme-icon--sun {
		display: none;
	}

	:global([data-theme='light']) .theme-icon--moon {
		display: block;
	}

	.menu-btn {
		display: grid;
	}

	@media (min-width: 768px) {
		.menu-btn {
			display: none;
		}
	}

	.menu-line {
		transform-box: fill-box;
		transform-origin: center;
		transition: transform 0.45s var(--ease);
	}

	.site-header[data-open] .menu-line--top {
		transform: translateY(4px) rotate(45deg);
	}

	.site-header[data-open] .menu-line--bottom {
		transform: translateY(-4px) rotate(-45deg);
	}

	.mobile-menu {
		display: flex;
		flex-direction: column;
		max-width: 64rem;
		margin: 0.5rem auto 0;
		padding: 0.5rem;
		border-radius: 1.5rem;
		border: 1px solid var(--line);
		background: color-mix(in oklab, var(--surface) 88%, transparent);
		-webkit-backdrop-filter: blur(18px);
		backdrop-filter: blur(18px);
		box-shadow: var(--shadow-soft);
		opacity: 0;
		visibility: hidden;
		transform: translateY(-8px) scale(0.98);
		transform-origin: top center;
		transition:
			opacity 0.35s var(--ease),
			transform 0.5s var(--ease),
			visibility 0.35s;
	}

	.site-header[data-open] .mobile-menu {
		opacity: 1;
		visibility: visible;
		transform: none;
	}

	@media (min-width: 768px) {
		.mobile-menu {
			display: none;
		}
	}

	.mobile-menu__link {
		padding: 0.9rem 1.1rem;
		border-radius: 1rem;
		font-weight: 500;
		color: var(--soft);
		transition:
			background-color 0.3s,
			color 0.3s;
	}

	.mobile-menu__link:hover,
	.mobile-menu__link[aria-current='page'] {
		background: var(--raised);
		color: var(--fg);
	}
</style>
