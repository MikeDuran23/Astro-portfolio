---
import { site } from '../data/site';
import GithubMenu from './GithubMenu.astro';
import { getLang, localePath, switchPath, useTranslations } from '../i18n/ui';

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const other = lang === 'es' ? 'en' : 'es';
const switchHref = switchPath(Astro.url.pathname, other);

// Current path without the language prefix, to mark the active link
const path = Astro.url.pathname.replace(/^\/es(?=\/|$)/, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---

<header class="site-header" data-header transition:persist="header">
	<nav class="bar" aria-label={t.mainNav}>
		<a href={localePath(lang, '/')} class="brand" aria-label={`${site.name}, ${t.homeLabel}`}>
			<span class="brand__dot" aria-hidden="true"></span>
			<span>{site.name}</span>
		</a>

		<div class="nav" data-nav>
			<span class="nav__pill" data-nav-pill aria-hidden="true"></span>
			{
				site.nav.map((item) => (
					<a
						href={localePath(lang, item.href)}
						class="nav__link"
						data-nav-link
						data-exact={item.href === '/' ? '' : undefined}
						aria-current={isActive(item.href) ? 'page' : undefined}
					>
						{t.nav[item.key]}
					</a>
				))
			}
		</div>

		<div class="actions">
			<GithubMenu />
			<a href={switchHref} class="icon-btn lang-btn" data-lang-switch data-astro-reload hreflang={other} lang={other} aria-label={t.language.label} title={t.language.label}>{t.language.code}</a>

			<button type="button" class="icon-btn" data-theme-toggle aria-label={t.theme}>
				<svg class="theme-icon theme-icon--sun" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
				</svg>
				<svg class="theme-icon theme-icon--moon" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"></path>
				</svg>
			</button>

			<button type="button" class="icon-btn menu-btn" data-menu-button aria-expanded="false" aria-controls="mobile-menu" aria-label={t.menuOpen} data-label-open={t.menuOpen} data-label-close={t.menuClose}>
				<svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true">
					<path class="menu-line menu-line--top" d="M4 8h16"></path>
					<path class="menu-line menu-line--bottom" d="M4 16h16"></path>
				</svg>
			</button>
		</div>
	</nav>

	<div id="mobile-menu" class="mobile-menu" data-menu>
		{
			site.nav.map((item) => (
				<a
					href={localePath(lang, item.href)}
					class="mobile-menu__link"
					data-menu-link
					data-exact={item.href === '/' ? '' : undefined}
					aria-current={isActive(item.href) ? 'page' : undefined}
				>
					{t.nav[item.key]}
				</a>
			))
		}
	</div>
</header>

<style>
	.site-header {
		position: fixed;
		inset: 1rem 0 auto 0;
		z-index: 50;
		padding: 0 1rem;
		pointer-events: none;
	}

	.bar,
	.mobile-menu {
		pointer-events: auto;
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		max-width: 64rem;
		margin-inline: auto;
		padding: 0.5rem 0.5rem 0.5rem 1.25rem;
		border-radius: 999px;
		border: 1px solid var(--line);
		background: color-mix(in oklab, var(--surface) 55%, transparent);
		-webkit-backdrop-filter: blur(18px) saturate(1.4);
		backdrop-filter: blur(18px) saturate(1.4);
		transition:
			background-color 0.4s,
			box-shadow 0.5s var(--ease);
	}

	.site-header[data-scrolled] .bar {
		background: color-mix(in oklab, var(--surface) 82%, transparent);
		box-shadow: var(--shadow-soft);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		font-family: var(--f-display);
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--fg);
	}

	.brand__dot {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: linear-gradient(135deg, var(--accent), var(--accent-2));
		transition: transform 0.5s var(--ease);
	}

	.brand:hover .brand__dot {
		transform: scale(1.5);
	}

	.nav {
		position: relative;
		display: none;
		align-items: center;
		gap: 0.15rem;
		padding: 0.25rem;
	}

	@media (min-width: 768px) {
		.nav {
			display: flex;
		}
	}

	.nav__pill {
		position: absolute;
		top: 0.25rem;
		bottom: 0.25rem;
		left: 0;
		width: 0;
		border-radius: 999px;
		background: var(--raised);
		opacity: 0;
		transition:
			transform 0.55s var(--ease),
			width 0.55s var(--ease),
			opacity 0.3s;
	}

	.nav__pill:not([data-ready]) {
		transition: none;
	}

	.nav__link {
		position: relative;
		padding: 0.5rem 1.1rem;
		border-radius: 999px;
		font-size: 0.92rem;
		font-weight: 500;
		color: var(--muted);
		transition: color 0.3s;
	}

	.nav__link:hover,
	.nav__link[aria-current='page'] {
		color: var(--fg);
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.icon-btn {
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		color: var(--soft);
		transition:
			background-color 0.3s,
			color 0.3s,
			transform 0.45s var(--ease);
	}

	.icon-btn:hover {
		background: var(--raised);
		color: var(--fg);
	}

	.icon-btn:active {
		transform: scale(0.92);
	}

	.lang-btn {
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.04em;
	}

	.theme-icon--moon {
		display: none;
	}

	:global([data-theme='light']) .theme-icon--sun {
		display: none;
	}

	:global([data-theme='light']) .theme-icon--moon {
		display: block;
	}

	.menu-btn {
		display: grid;
	}

	@media (min-width: 768px) {
		.menu-btn {
			display: none;
		}
	}

	.menu-line {
		transform-box: fill-box;
		transform-origin: center;
		transition: transform 0.45s var(--ease);
	}

	.site-header[data-open] .menu-line--top {
		transform: translateY(4px) rotate(45deg);
	}

	.site-header[data-open] .menu-line--bottom {
		transform: translateY(-4px) rotate(-45deg);
	}

	.mobile-menu {
		display: flex;
		flex-direction: column;
		max-width: 64rem;
		margin: 0.5rem auto 0;
		padding: 0.5rem;
		border-radius: 1.5rem;
		border: 1px solid var(--line);
		background: color-mix(in oklab, var(--surface) 88%, transparent);
		-webkit-backdrop-filter: blur(18px);
		backdrop-filter: blur(18px);
		box-shadow: var(--shadow-soft);
		opacity: 0;
		visibility: hidden;
		transform: translateY(-8px) scale(0.98);
		transform-origin: top center;
		transition:
			opacity 0.35s var(--ease),
			transform 0.5s var(--ease),
			visibility 0.35s;
	}

	.site-header[data-open] .mobile-menu {
		opacity: 1;
		visibility: visible;
		transform: none;
	}

	@media (min-width: 768px) {
		.mobile-menu {
			display: none;
		}
	}

	.mobile-menu__link {
		padding: 0.9rem 1.1rem;
		border-radius: 1rem;
		font-weight: 500;
		color: var(--soft);
		transition:
			background-color 0.3s,
			color 0.3s;
	}

	.mobile-menu__link:hover,
	.mobile-menu__link[aria-current='page'] {
		background: var(--raised);
		color: var(--fg);
	}
</style>
