---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, description, technologies = [], cover, date, logo, logoBackground, logoPixelated } = project.data;

const when = date
	? new Date(date).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })
	: null;
const href = `/projects/${project.slug}`;
const visible = technologies.slice(0, 5);
const extra = technologies.length - visible.length;
const isVideo = !!cover && /\.(mp4|webm)$/i.test(cover);
---

<article class="card" data-card data-spotlight>
	<div class="card__media">
		{
			logo && (
				<div class="card__logo" style={logoBackground ? `background:${logoBackground}` : undefined}>
					<img src={logo} alt={`${title} logo`} class:list={{ pixelated: logoPixelated }} loading="lazy" />
				</div>
			)
		}
		{!logo && <div class="card__fallback" aria-hidden="true">{title.charAt(0)}</div>}
		{
			!logo && cover && isVideo && (
				<video
					class="card__video"
					data-card-video
					src={`${cover}#t=0.1`}
					muted
					loop
					playsinline
					preload="metadata"
					aria-hidden="true"
					tabindex="-1"
				/>
			)
		}
		{!logo && cover && !isVideo && <img class="card__video is-ready" src={cover} alt="" loading="lazy" />}
	</div>

	<div class="card__body">
		<div>
			{when && <p class="text-sm text-muted">{when}</p>}
			<h3 class="display-md mt-2">
				<a href={href} class="card__link">{title}</a>
			</h3>
			<p class="mt-4 line-clamp-4 text-soft">{description}</p>
		</div>

		<div>
			{
				visible.length > 0 && (
					<ul class="flex flex-wrap gap-2" aria-label="Technologies">
						{visible.map((tech) => (
							<li class="chip">{tech}</li>
						))}
						{extra > 0 && <li class="chip">+{extra}</li>}
					</ul>
				)
			}
			<span class="link-arrow mt-6">
				View project
				<svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M5 12h14M13 6l6 6-6 6"></path>
				</svg>
			</span>
		</div>
	</div>
</article>

<style>
	.card {
		position: relative;
		display: grid;
		isolation: isolate;
		overflow: hidden;
		border-radius: 1.75rem;
		border: 1px solid var(--line);
		background: color-mix(in oklab, var(--surface) 70%, transparent);
		transition:
			border-color 0.5s var(--ease),
			box-shadow 0.6s var(--ease);
	}

	@media (min-width: 860px) {
		.card {
			grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
		}
	}

	/* Light that follows the cursor inside the card */
	.card::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.5s;
		background: radial-gradient(
			520px circle at var(--mx, 50%) var(--my, 50%),
			color-mix(in oklab, var(--accent) 16%, transparent),
			transparent 60%
		);
	}

	.card:hover::before,
	.card:focus-within::before {
		opacity: 1;
	}

	.card:hover,
	.card:focus-within {
		border-color: color-mix(in oklab, var(--accent) 45%, var(--line));
		box-shadow: var(--shadow);
	}

	.card__media {
		position: relative;
		z-index: 1;
		aspect-ratio: 16 / 10;
		margin: 0.75rem;
		overflow: hidden;
		border-radius: 1.2rem;
		background: var(--raised);
	}

	.card__fallback {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		font-family: var(--f-display);
		font-size: 6rem;
		font-weight: 800;
		color: var(--fg);
		background:
			radial-gradient(120% 120% at 15% 0%, var(--glow-a), transparent 60%),
			radial-gradient(120% 120% at 100% 100%, var(--glow-b), transparent 60%), var(--raised);
	}

	.card__logo {
		position: absolute;
		inset: 0;
		display: grid;
		grid-template: minmax(0, 1fr) / minmax(0, 1fr);
		padding: 9%;
	}

	.card__logo img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		transition: transform 0.9s var(--ease);
	}

	.card__logo img.pixelated {
		image-rendering: pixelated;
	}

	.card:hover .card__logo img {
		transform: scale(1.05);
	}

	.card__video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		transform: scale(1.02);
		transition:
			opacity 0.7s var(--ease),
			transform 1.4s var(--ease);
	}

	.card__video:global(.is-ready) {
		opacity: 1;
	}

	.card:hover .card__video {
		transform: scale(1.06);
	}

	.card__body {
		z-index: 1;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 2rem;
		padding: 1.5rem 1.75rem 2rem;
	}

	@media (min-width: 860px) {
		.card__body {
			padding: 2.5rem 2.5rem 2.5rem 1.5rem;
		}
	}

	/* The whole card acts as a single accessible link */
	.card__link::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 2;
	}
</style>
