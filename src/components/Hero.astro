---
import { site } from '../data/site';
import { getLang, localePath, useTranslations } from '../i18n/ui';

const lang = getLang(Astro.url);
const t = useTranslations(lang);
---

<section class="hero" aria-labelledby="hero-title">
	<div class="hero__inner mx-auto w-full max-w-6xl px-6">
		<h1 id="hero-title" class="display-xl">
			<span class="line" style="--i: 0"><span>{t.hero.line1}</span></span>
			<span class="line line--soft" style="--i: 1"><span>{t.hero.line2}</span></span>
		</h1>

		<p class="hero__lead rise" style="--d: 650ms">
			{t.hero.lead}
		</p>

		<div class="hero__cta rise" style="--d: 800ms">
			<a href={localePath(lang, '/projects')} class="btn btn-primary">
				{t.hero.cta}
				<svg class="btn-arrow" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M5 12h14M13 6l6 6-6 6"></path>
				</svg>
			</a>
			{
				site.githubAccounts.map((account) => (
					<a
						href={account.url}
						class="btn btn-ghost"
						target="_blank"
						rel="noopener noreferrer"
						title={account.kind === 'current' ? t.github.current : t.github.student}
					>
						<svg width="16" height="16" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
					<path fill-rule="evenodd" d="M10 0C4.477 0 0 4.477 0 10c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.868-.013-1.703-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.545 2.914 1.209.092-.937.349-1.546.635-1.901-2.22-.252-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0110 4.817c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C17.137 18.167 20 14.42 20 10c0-5.523-4.477-10-10-10z" clip-rule="evenodd"></path>
				</svg>
						{account.handle}
					</a>
				))
			}
			{
				site.linkedin && (
					<a href={site.linkedin} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
						<svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"></path>
						</svg>
						LinkedIn
					</a>
				)
			}
		</div>

		<p class="hero__status rise" style="--d: 950ms">
			<span class="status-dot" aria-hidden="true"></span>
			{t.hero.status}
		</p>
	</div>
</section>

<style>
	.hero {
		display: flex;
		align-items: center;
		min-height: 100svh;
		padding: 8rem 0 5rem;
	}

	.hero__inner {
		max-width: 72rem;
	}

	/* Each line rises from a mask: the page's one signature entrance */
	.line {
		display: block;
		overflow: hidden;
		padding-block: 0.08em 0.14em;
		margin-block: -0.08em -0.14em;
	}

	.line > span {
		display: block;
		transform: translateY(105%);
		animation: line-up 1.1s var(--ease) forwards;
		animation-delay: calc(var(--i) * 120ms + 150ms);
	}

	.line--soft {
		color: var(--muted);
		max-width: 16em;
	}

	@keyframes line-up {
		to {
			transform: none;
		}
	}

	.hero__lead {
		max-width: 36rem;
		margin-top: 2.25rem;
		font-size: clamp(1.05rem, 1.4vw, 1.25rem);
		line-height: 1.6;
		color: var(--soft);
	}

	.hero__cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2.5rem;
	}

	.hero__status {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		margin-top: 3.5rem;
		font-size: 0.9rem;
		color: var(--muted);
	}

	.status-dot {
		position: relative;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: #34d399;
	}

	.status-dot::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 50%;
		background: #34d399;
		animation: pulse 2.4s ease-out infinite;
	}

	@keyframes pulse {
		from {
			transform: scale(1);
			opacity: 0.6;
		}
		to {
			transform: scale(3.2);
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.line > span {
			transform: none;
			animation: none;
		}

		.status-dot::after {
			animation: none;
			opacity: 0;
		}
	}

	/* On scroll, the hero text fades out gently */
	@keyframes hero-exit {
		to {
			opacity: 0;
			transform: translateY(-40px);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: scroll()) {
			.hero__inner {
				animation: hero-exit linear both;
				animation-timeline: scroll(root block);
				animation-range: 0 70vh;
			}
		}
	}
</style>
