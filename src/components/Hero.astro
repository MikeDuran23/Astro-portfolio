---
import { site } from '../data/site';
---

<section class="hero" aria-labelledby="hero-title">
	<div class="hero__inner mx-auto w-full max-w-6xl px-6">
		<h1 id="hero-title" class="display-xl">
			<span class="line" style="--i: 0"><span>Hi, I'm Miguel.</span></span>
			<span class="line line--soft" style="--i: 1"><span>I build web applications from end to end.</span></span>
		</h1>

		<p class="hero__lead rise" style="--d: 650ms">
			{site.role} focused on complete architectures, from a robust backend to intuitive interfaces.
			I love solving real problems with clean code.
		</p>

		<div class="hero__cta rise" style="--d: 800ms">
			<a href="/projects" class="btn btn-primary">
				View projects
				<svg class="btn-arrow" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M5 12h14M13 6l6 6-6 6"></path>
				</svg>
			</a>
			<a href={site.github} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
				<svg width="16" height="16" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
					<path fill-rule="evenodd" d="M10 0C4.477 0 0 4.477 0 10c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.868-.013-1.703-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.545 2.914 1.209.092-.937.349-1.546.635-1.901-2.22-.252-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0110 4.817c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C17.137 18.167 20 14.42 20 10c0-5.523-4.477-10-10-10z" clip-rule="evenodd"></path>
				</svg>
				GitHub
			</a>
		</div>

		<p class="hero__status rise" style="--d: 950ms">
			<span class="status-dot" aria-hidden="true"></span>
			Available for new opportunities
		</p>
	</div>
</section>

<style>
	.hero {
		display: flex;
		align-items: center;
		min-height: 100svh;
		padding: 8rem 0 5rem;
	}

	.hero__inner {
		max-width: 72rem;
	}

	/* Each line rises from a mask: the page's one signature entrance */
	.line {
		display: block;
		overflow: hidden;
		padding-block: 0.08em 0.14em;
		margin-block: -0.08em -0.14em;
	}

	.line > span {
		display: block;
		transform: translateY(105%);
		animation: line-up 1.1s var(--ease) forwards;
		animation-delay: calc(var(--i) * 120ms + 150ms);
	}

	.line--soft {
		color: var(--muted);
		max-width: 16em;
	}

	@keyframes line-up {
		to {
			transform: none;
		}
	}

	.hero__lead {
		max-width: 36rem;
		margin-top: 2.25rem;
		font-size: clamp(1.05rem, 1.4vw, 1.25rem);
		line-height: 1.6;
		color: var(--soft);
	}

	.hero__cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2.5rem;
	}

	.hero__status {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		margin-top: 3.5rem;
		font-size: 0.9rem;
		color: var(--muted);
	}

	.status-dot {
		position: relative;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: #34d399;
	}

	.status-dot::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 50%;
		background: #34d399;
		animation: pulse 2.4s ease-out infinite;
	}

	@keyframes pulse {
		from {
			transform: scale(1);
			opacity: 0.6;
		}
		to {
			transform: scale(3.2);
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.line > span {
			transform: none;
			animation: none;
		}

		.status-dot::after {
			animation: none;
			opacity: 0;
		}
	}

	/* On scroll, the hero text fades out gently */
	@keyframes hero-exit {
		to {
			opacity: 0;
			transform: translateY(-40px);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: scroll()) {
			.hero__inner {
				animation: hero-exit linear both;
				animation-timeline: scroll(root block);
				animation-range: 0 70vh;
			}
		}
	}
</style>
