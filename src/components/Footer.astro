---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
	<div class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-10 sm:flex-row sm:items-center sm:justify-between">
		<p class="text-sm text-muted">© {year} {site.name}. Built with Astro.</p>
		<nav class="flex gap-6 text-sm" aria-label="Footer">
			{
				site.nav.map((item) => (
					<a href={item.href} class="text-soft transition-colors hover:text-fg">
						{item.label}
					</a>
				))
			}
			<a href={site.github} class="text-soft transition-colors hover:text-fg" target="_blank" rel="noopener noreferrer">
				GitHub
			</a>
		</nav>
	</div>
</footer>
