---
import { site } from '../data/site';
import { getLang, useTranslations } from '../i18n/ui';

const t = useTranslations(getLang(Astro.url));
---

<div class="gh" data-gh>
	<button type="button" class="icon-btn" data-gh-button aria-expanded="false" aria-controls="gh-panel" aria-label={t.github.menu}>
		<svg width="18" height="18" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
			<path fill-rule="evenodd" d="M10 0C4.477 0 0 4.477 0 10c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.868-.013-1.703-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.545 2.914 1.209.092-.937.349-1.546.635-1.901-2.22-.252-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0110 4.817c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C17.137 18.167 20 14.42 20 10c0-5.523-4.477-10-10-10z" clip-rule="evenodd"></path>
		</svg>
	</button>

	<div id="gh-panel" class="gh__panel" data-gh-panel>
		{
			site.githubAccounts.map((account) => (
				<a href={account.url} class="gh__link" target="_blank" rel="noopener noreferrer">
					<span class="gh__handle">{account.handle}</span>
					<span class="gh__kind">{account.kind === 'current' ? t.github.current : t.github.student}</span>
				</a>
			))
		}
	</div>
</div>

<style>
	.gh {
		position: relative;
	}

	/* Same look as the other header buttons (their styles are scoped to Header) */
	.icon-btn {
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		color: var(--soft);
		transition:
			background-color 0.3s,
			color 0.3s,
			transform 0.45s var(--ease);
	}

	.icon-btn:hover,
	.gh[data-open] .icon-btn {
		background: var(--raised);
		color: var(--fg);
	}

	.icon-btn:active {
		transform: scale(0.92);
	}

	.gh__panel {
		position: absolute;
		top: calc(100% + 0.9rem);
		right: -0.25rem;
		display: flex;
		flex-direction: column;
		min-width: 15.5rem;
		padding: 0.4rem;
		border-radius: 1.2rem;
		border: 1px solid var(--line);
		background: color-mix(in oklab, var(--surface) 92%, transparent);
		-webkit-backdrop-filter: blur(18px);
		backdrop-filter: blur(18px);
		box-shadow: var(--shadow-soft);
		opacity: 0;
		visibility: hidden;
		transform: translateY(-6px) scale(0.97);
		transform-origin: top right;
		transition:
			opacity 0.3s var(--ease),
			transform 0.45s var(--ease),
			visibility 0.3s;
	}

	.gh[data-open] .gh__panel {
		opacity: 1;
		visibility: visible;
		transform: none;
	}

	.gh__link {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		padding: 0.65rem 0.9rem;
		border-radius: 0.85rem;
		transition: background-color 0.3s;
	}

	.gh__link:hover {
		background: var(--raised);
	}

	.gh__handle {
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--fg);
	}

	.gh__kind {
		font-size: 0.8rem;
		color: var(--muted);
	}
</style>
