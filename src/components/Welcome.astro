<div class="hero-section">
	<div class="container mx-auto px-4 py-20 md:py-32 relative z-10">
		<div class="max-w-4xl mx-auto">
			<!-- Main Title with Glow -->
			<div class="mb-8 space-y-6">
				<h1 class="text-6xl md:text-7xl font-black leading-tight">
					Hi, <span class="cyber-gradient">I'm Miguel</span>
				</h1>

				<p class="text-2xl md:text-3xl text-slate-300 font-semibold">
					COMPUTER ENGINEER
				</p>

				<p class="text-lg text-gray-400 max-w-2xl leading-relaxed">
					Construyo aplicaciones web modernas y escalables. Especializado en arquitecturas completas,
					desde backend robusto hasta interfaces intuitivas. Apasionado por resolver problemas reales con código limpio.
				</p>
			</div>

			<!-- CTA Buttons -->
			<div class="flex flex-row flex-wrap gap-3 mb-20">
				<a href="/projects" class="cyber-btn-primary">
					<span class="flex items-center justify-center gap-2">
						VER PROYECTOS
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
						</svg>
					</span>
				</a>
				<a href="https://github.com/MiguelDuranAltes" target="_blank" rel="noopener noreferrer" class="cyber-btn-secondary">
					<span class="flex items-center justify-center gap-2">
						GITHUB PROFILE
						<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M10 0C4.477 0 0 4.477 0 10c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.868-.013-1.703-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.545 2.914 1.209.092-.937.349-1.546.635-1.901-2.22-.252-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0110 4.817c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C17.137 18.167 20 14.42 20 10c0-5.523-4.477-10-10-10z" clip-rule="evenodd"></path>
						</svg>
					</span>
				</a>
			</div>

			<!-- Stats Grid with Cyber Style -->
			<div class="grid md:grid-cols-3 gap-6 py-12 border-t border-b border-cyan-500/20">
				<div class="stat-card group">
								<div class="text-4xl md:text-5xl font-black text-cyan-200 mb-2 group-hover:text-cyan-100 transition">5+</div>
								<p class="text-slate-400 uppercase tracking-wider text-sm">Proyectos Completados</p>
								<div class="h-0.5 w-0 group-hover:w-full bg-gradient-to-r from-cyan-300 to-transparent transition-all duration-300"></div>
				</div>
				<div class="stat-card group">
								<div class="text-4xl md:text-5xl font-black text-purple-300 mb-2 group-hover:text-purple-200 transition">FULL</div>
								<p class="text-slate-400 uppercase tracking-wider text-sm">-STACK ENGINEER</p>
								<div class="h-0.5 w-0 group-hover:w-full bg-gradient-to-r from-purple-300 to-transparent transition-all duration-300"></div>
				</div>
				<div class="stat-card group">
								<div class="text-4xl md:text-5xl font-black text-pink-300 mb-2 group-hover:text-pink-200 transition">SCRUM</div>
								<p class="text-slate-400 uppercase tracking-wider text-sm">Metodología</p>
								<div class="h-0.5 w-0 group-hover:w-full bg-gradient-to-r from-pink-300 to-transparent transition-all duration-300"></div>
				</div>
			</div>

			<!-- Tech Stack -->
			<div class="mt-16">
				<p class="text-cyan-200 font-bold mb-6 uppercase tracking-widest text-sm">// STACK TECNOLÓGICO</p>
				<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
					<div class="tech-badge">Vue.js</div>
					<div class="tech-badge">React</div>
					<div class="tech-badge">Java</div>
					<div class="tech-badge">Spring Boot</div>
					<div class="tech-badge">MongoDB</div>
					<div class="tech-badge">GraphQL</div>
					<div class="tech-badge">Astro</div>
					<div class="tech-badge">Tailwind</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Floating Cyber Elements -->
	<div class="floating-elements">
		<div class="cyber-blob blob-1"></div>
		<div class="cyber-blob blob-2"></div>
		<div class="cyber-blob blob-3"></div>
		<div class="grid-overlay"></div>
	</div>
</div>

<style>
	.hero-section {
		position: relative;
		overflow: hidden;
		min-height: 100vh;
		display: flex;
		align-items: center;
		background: radial-gradient(circle at 20% 50%, rgba(139, 233, 255, 0.04) 0%, transparent 48%),
		            radial-gradient(circle at 80% 80%, rgba(143, 103, 255, 0.04) 0%, transparent 48%);
	}

	.cyber-gradient {
		background: linear-gradient(135deg, #8be9ff 0%, #c9f6ff 50%, #8f67ff 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		text-shadow: 0 0 20px rgba(139, 233, 255, 0.16);
		filter: drop-shadow(0 0 14px rgba(139, 233, 255, 0.16));
	}

	.stat-card {
		padding: 1.5rem;
		border-bottom: 2px solid transparent;
		transition: all 0.3s ease;
	}

	.stat-card:hover {
		border-bottom-color: currentColor;
	}

	.tech-badge {
		padding: 0.75rem 1rem;
		background: rgba(139, 233, 255, 0.08);
		border: 1px solid rgba(139, 233, 255, 0.22);
		border-radius: 8px;
		color: #c9f6ff;
		font-size: 0.875rem;
		font-weight: 600;
		text-align: center;
		cursor: default;
		transition: all 0.3s ease;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.tech-badge:hover {
		background: rgba(139, 233, 255, 0.14);
		border-color: rgba(139, 233, 255, 0.42);
		box-shadow: 0 0 12px rgba(139, 233, 255, 0.14);
		transform: translateY(-2px);
	}

	/* Floating Cyber Blobs */
	.floating-elements {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.cyber-blob {
		position: absolute;
		border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
		opacity: 0.06;
		filter: blur(50px);
		animation: float 15s ease-in-out infinite;
	}

	.blob-1 {
		width: 400px;
		height: 400px;
		background: linear-gradient(135deg, rgba(139, 233, 255, 0.55), rgba(143, 103, 255, 0.45));
		top: -100px;
		right: -100px;
		animation-delay: 0s;
	}

	.blob-2 {
		width: 300px;
		height: 300px;
		background: linear-gradient(135deg, rgba(143, 103, 255, 0.45), rgba(255, 77, 141, 0.35));
		bottom: -50px;
		left: -50px;
		animation-delay: 2s;
	}

	.blob-3 {
		width: 250px;
		height: 250px;
		background: linear-gradient(135deg, rgba(201, 246, 255, 0.45), rgba(139, 233, 255, 0.45));
		top: 50%;
		left: 10%;
		animation-delay: 4s;
	}

	@keyframes float {
		0%, 100% {
			transform: translate(0, 0) rotate(0deg);
		}
		33% {
			transform: translate(30px, -50px) rotate(120deg);
		}
		66% {
			transform: translate(-20px, 20px) rotate(240deg);
		}
	}

	@media screen and (max-width: 768px) {
		.cyber-blob {
			opacity: 0.05;
		}

		.blob-1 {
			width: 250px;
			height: 250px;
		}

		.blob-2 {
			width: 200px;
			height: 200px;
		}

		.blob-3 {
			width: 150px;
			height: 150px;
		}
	}

	.cyber-btn-primary {
		padding: 0.8rem 1.3rem;
		background: linear-gradient(135deg, rgba(139, 233, 255, 0.08) 0%, rgba(143, 103, 255, 0.06) 100%);
		border: 1px solid rgba(139, 233, 255, 0.35);
		border-radius: 8px;
		color: #c9f6ff;
		font-weight: 700;
		font-size: 0.92rem;
		cursor: pointer;
		transition: all 0.3s ease;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		display: inline-block;
		text-decoration: none;
		position: relative;
		overflow: hidden;
	}

	.cyber-btn-primary::before {
		content: '';
		position: absolute;
		top: 0;
		left: -100%;
		width: 100%;
		height: 100%;
		background: linear-gradient(90deg, transparent, rgba(139, 233, 255, 0.18), transparent);
		transition: left 0.5s ease;
	}

	.cyber-btn-primary:hover {
		border-color: rgba(139, 233, 255, 0.55);
		box-shadow: 0 0 18px rgba(139, 233, 255, 0.16), inset 0 0 10px rgba(139, 233, 255, 0.08);
		transform: translateY(-2px);
	}

	.cyber-btn-primary:hover::before {
		left: 100%;
	}

	.cyber-btn-secondary {
		padding: 0.8rem 1.3rem;
		background: linear-gradient(135deg, rgba(143, 103, 255, 0.1) 0%, rgba(255, 77, 141, 0.05) 100%);
		border: 1px solid rgba(143, 103, 255, 0.35);
		border-radius: 8px;
		color: #cbb7ff;
		font-weight: 700;
		font-size: 0.92rem;
		cursor: pointer;
		transition: all 0.3s ease;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		display: inline-block;
		text-decoration: none;
	}

	.cyber-btn-secondary:hover {
		border-color: rgba(199, 125, 255, 0.55);
		box-shadow: 0 0 18px rgba(143, 103, 255, 0.16), inset 0 0 10px rgba(143, 103, 255, 0.08);
		transform: translateY(-2px);
		color: #e2d5ff;
	}
</style>
